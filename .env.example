DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require"
ADMIN_EMAIL="admin@example.com"
ADMIN_SESSION_SECRET="replace-with-at-least-32-random-characters"
# Set a separate 32+ character random value only during initial admin setup.
ADMIN_SETUP_TOKEN=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
RESEND_API_KEY="re_replace_with_your_resend_api_key"
# Required for Vercel-hosted inquiry analysis. Local Codex/Claude CLI use your existing login;
# this placeholder is ignored locally when INQUIRY_AI_PROVIDER is codex or claude.
OPENROUTER_API_KEY="sk-or-replace-me"
OPENROUTER_MODEL="google/gemini-2.5-flash"
# Local only: codex (default) or claude. Vercel always uses OpenRouter.
INQUIRY_AI_PROVIDER="codex"
# Optional model override for internal inquiry analysis; defaults to OPENROUTER_MODEL.
INQUIRY_AI_MODEL=""
# Optional sender identity for inquiry notifications; defaults to the configured site sender.
RESEND_FROM=""
